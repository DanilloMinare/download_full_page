{
  "manifest_version": 3,
  "name": "Captura de Página Inteira",
  "short_name": "Página Inteira",
  "description": "Captura a página inteira (com rolagem) em PNG, JPG ou PDF, com editor de anotações.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Capturar página inteira (Alt+Shift+P)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+P" }
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "downloads"]
}
